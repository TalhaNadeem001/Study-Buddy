# OpenAI API key — required for the concise-rewrite feature
OPENAI_API_KEY=sk-...

# Model used to rewrite dictation into a concise note (optional; defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Port the API listens on (optional; defaults to 3001)
PORT=3001

# Comma-separated list of origins allowed to call the API (optional)
CORS_ORIGIN=http://localhost:5173
