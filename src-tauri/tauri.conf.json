{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Buddy AI",
  "version": "0.1.0",
  "identifier": "ai.zappd.studybuddy",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Study Buddy AI",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Study Buddy — listening",
        "url": "index.html#/overlay",
        "width": 260,
        "height": 64,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/models"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
